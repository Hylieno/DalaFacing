<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.2.0.0</Version>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <Author>DalaLeno</Author>
    <Name>DalaFacing</Name>
    <Punchline>See exactly where a selected enemy is facing.</Punchline>
    <Description>Draws a configurable volumetric world-space arrow above one selected enemy and keeps tracking it when your game target changes.</Description>
    <Tags>combat;target;facing;overlay</Tags>
    <IconUrl>https://raw.githubusercontent.com/Hylieno/DalaLeno/main/plugins/DalaFacing/icon.png</IconUrl>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Update="DalamudPackager" Version="15.0.0" />
  </ItemGroup>
</Project>
